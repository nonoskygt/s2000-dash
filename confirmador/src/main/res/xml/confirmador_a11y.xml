<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin lista de paquetes: la ROM de este radio muestra el dialogo de
  emparejamiento Bluetooth desde un paquete propio que no es ninguno de los
  de AOSP, asi que filtrar por nombre dejaba al servicio ciego justo cuando
  hacia falta.

  El alcance real lo limita el codigo, no el manifiesto: el servicio no
  toca NADA salvo que el tablero haya armado una instalacion o un PIN, y
  esas ventanas duran segundos.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="200"
    android:description="@string/a11y_description" />
