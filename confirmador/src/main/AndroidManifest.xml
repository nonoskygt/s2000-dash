<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permiso de nivel "signature": solo una app firmada con el mismo
      certificado que este APK puede armar una confirmacion. Sin esto,
      cualquier app del radio podria abrir la ventana a voluntad.
    -->
    <permission
        android:name="com.nonosky.s2000dash.permission.ARMAR"
        android:protectionLevel="signature" />

    <!-- Para contarle al tablero lo que se ve en pantalla. Nivel
         "signature": solo funciona entre APK con el mismo certificado. -->
    <uses-permission android:name="com.nonosky.s2000dash.permission.ARMAR" />

    <queries>
        <package android:name="com.nonosky.s2000dash" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:label="@string/app_name">

        <!-- Los Ajustes de este radio no listan Accesibilidad; esta pantalla
             abre la del sistema por intent, que si existe. -->
        <activity
            android:name=".AbrirAccesibilidadActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ArmarReceiver"
            android:exported="true"
            android:permission="com.nonosky.s2000dash.permission.ARMAR">
            <intent-filter>
                <action android:name="com.nonosky.s2000dash.ARMAR_INSTALACION" />
                <action android:name="com.nonosky.s2000dash.DESARMAR_INSTALACION" />
                <action android:name="com.nonosky.s2000dash.ARMAR_PIN" />
                <action android:name="com.nonosky.s2000dash.MANDO" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ConfirmarInstalacionService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/confirmador_a11y" />
        </service>
    </application>

</manifest>
